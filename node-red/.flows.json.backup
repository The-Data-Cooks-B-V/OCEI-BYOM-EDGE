    {
        "id": "e7a206a7d65012b9",
        "type": "function",
        "z": "e7008fac9d7a2047",
        "name": "⏱ End Timer — Log Latency",
        "func": "const elapsed = Date.now() - (msg._startTime || Date.now());\nconst passed = elapsed < 100;\nnode.warn(`✅ Verification latency: ${elapsed} ms | Target: < 100 ms | Status: ${passed ? 'PASS ✅' : 'FAIL ❌'}`);\nnode.status({\n    fill: passed ? \"green\" : \"red\",\n    shape: \"dot\",\n    text: `${elapsed} ms — ${passed ? 'PASS' : 'FAIL'}`\n});\nmsg.latencyMs = elapsed;\nmsg.latencyTarget = \"< 100 ms\";\nmsg.latencyPassed = passed;\nreturn msg;",
