    {
        "id": "ce3543b3c50a4b80",
        "type": "function",
        "z": "618d7734aad54e6b",
        "name": "Split Verification Rules",
        "func": "const ai = msg.ai || msg.payload;\nconst fields = msg.fields || ai?.fields || ai;\nconst rules = fields?.recommendation?.verification?.rules || [];\nif (!Array.isArray(rules) || !rules.length) { node.warn(\"NO verification.rules FOUND\"); return null; }\nconst recommendationId = msg.recommendationId || ai?.recommendationId || `${ai?.pk || \"PredictiveModelResult\"}#${ai?.sk || Date.now()}`;\nflow.set(`verify:${recommendationId}:expectedCount`, rules.length);\nflow.set(`verify:${recommendationId}:results`, []);\nflow.set(`verify:${recommendationId}:ai`, ai);\nconst messages = rules.map((rule, index) => ({ payload: rule, ai, fields, rule, ruleIndex: index, ruleCount: rules.length, recommendationId }));\nnode.status({ fill: \"green\", shape: \"dot\", text: `${rules.length} rules` });\nreturn [messages];",
        "outputs": 1,
