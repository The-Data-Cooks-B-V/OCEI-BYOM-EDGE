    {
        "id": "4ea575c6d7ba67ec",
        "type": "function",
        "z": "863be1bd35fec7b8",
        "name": "Normalize + Cache + Build Backend Payload",
        "func": "const mapping = msg.assetMapping;\nif (!mapping?.assetId) {\n    node.warn(\"assetMapping.assetId missing\");\n    return null;\n}\n\nfunction toMillis(rawTs) {\n    if (rawTs === null || rawTs === undefined || rawTs === \"\") return NaN;\n    if (typeof rawTs === \"number\") return rawTs < 100000000000 ? rawTs * 1000 : rawTs;\n    const n = Number(rawTs);\n    if (!Number.isNaN(n) && Number.isFinite(n)) return n < 100000000000 ? n * 1000 : n;\n    return new Date(rawTs).getTime();\n}\n\nconst rows = Array.isArray(msg.payload?.data) ? msg.payload.data : [];\nif (!rows.length) {\n    node.warn(\"NO ROWS\");\n    return null;\n}\n\nconst tsField = mapping.timestampField || \"ts\";\nconst valueField = mapping.valueField || \"energy_kwh\";\n\nconst samples = rows\n    .map(r => {\n        const ts = toMillis(r[tsField]);\n        const value = Number(r[valueField]);\n        if (!ts || Number.isNaN(ts) || Number.isNaN(value) || !Number.isFinite(value)) return null;\n        return {\n            ts,\n            value,\n            assetId: mapping.assetId,\n            customerId: mapping.customerId,\n            unit: mapping.unit,\n            sourceDeviceId: mapping.sourceDeviceId,\n            source: mapping.source,\n            rawTimestamp: r[tsField]\n        };\n    })\n    .filter(Boolean)\n    .sort((a, b) => a.ts - b.ts);\n\nif (!samples.length) {\n    node.warn(\"NO VALID SAMPLES\");\n    return null;\n}\n\nconst cacheKey = `assetSamples:${mapping.assetId}`;\nconst now = Date.now();\nconst maxAgeMs = 90 * 24 * 60 * 60 * 1000;\nconst existing = flow.get(cacheKey) || global.get(cacheKey) || [];\nconst byTs = new Map();\n\nfor (const s of existing) {\n    if (s?.ts && now - Number(s.ts) <= maxAgeMs) byTs.set(Number(s.ts), s);\n}\nfor (const s of samples) {\n    if (now - Number(s.ts) <= maxAgeMs) byTs.set(Number(s.ts), s);\n}\n\nconst merged = Array.from(byTs.values()).sort((a, b) => Number(a.ts) - Number(b.ts));\nflow.set(cacheKey, merged);\nglobal.set(cacheKey, merged);\n\nconst oneYearSeconds = 365 * 24 * 60 * 60;\nconst backendRecords = samples.map(s => {\n    const t = Math.floor(Number(s.ts) / 1000);\n    return {\n        asset_id: mapping.assetId,\n        timestamp: t,\n        customer_id: mapping.customerId || 71,\n        ttl: t + oneYearSeconds,\n        val: s.value\n    };\n});\n\nmsg.normalizedPayload = backendRecords;\nmsg.payload = backendRecords;\n\nnode.status({ fill: \"green\", shape: \"dot\", text: `cached=${merged.length} post=${backendRecords.length}` });\nreturn msg;",
