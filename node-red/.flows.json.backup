        "name": "Set Energy Asset Mapping",
        "func": "msg.assetMapping = {\n    assetId: \"1780305924234\",\n    customerId: 71,\n    source: \"SIM_ENERGY_5MIN\",\n    unit: \"kWh\",\n    sourceDeviceId: \"15\",\n    responsePath: \"data\",\n    timestampField: \"ts\",\n    valueField: \"energy_kwh\"\n};\n\nreturn msg;",
