    {
        "id": "4a4fa8ae54c74768",
        "type": "function",
        "z": "618d7734aad54e6b",
        "name": "Read Asset Samples From Cache",
        "func": "const ai = msg.ai || msg.payload;\nconst fields = msg.fields || ai?.fields || ai;\nconst rule = msg.rule || msg.payload;\nif (!rule?.assetId) { node.warn(\"RULE assetId MISSING\"); return null; }\nconst verification = fields?.recommendation?.verification;\nconst windowName = rule.window || \"observationWindow\";\nconst window = verification?.[windowName] || verification?.observationWindow || {};\nconst startMs = Number(window.startTime);\nconst endMs = Number(window.endTime);\nif (!startMs || !endMs || Number.isNaN(startMs) || Number.isNaN(endMs) || endMs <= startMs) { node.warn(`INVALID ${windowName} FOR assetId=${rule.assetId}`); return null; }\nconst key = `assetSamples:${rule.assetId}`;\nconst rows = flow.get(key) || global.get(key) || [];\nif (!Array.isArray(rows) || !rows.length) {\n    if (rule.required === false) { msg.assetRows = []; msg.rawValues = []; msg.sampleCount = 0; return msg; }\n    node.warn(`NO CACHED SAMPLES FOR ${key}`); return null;\n}\nconst filteredRows = rows.filter(r => {\n    const ts = Number(r.ts ?? r.timestamp ?? r.time);\n    return ts >= startMs && ts < endMs;\n});\nconst rawValues = filteredRows.map(r => r.value);\nif (!rawValues.length && rule.required !== false) { node.warn(`NO SAMPLES IN ${windowName} FOR assetId=${rule.assetId}`); return null; }\nmsg.assetRows = filteredRows; msg.rawValues = rawValues; msg.sampleCount = rawValues.length; msg.windowUsed = { name: windowName, startMs, endMs };\nnode.status({ fill: \"blue\", shape: \"dot\", text: `${rule.assetId} samples=${rawValues.length}` });\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 600,
        "y": 340,
        "wires": [
            [
                "63d4a278241446ae"
            ]
        ]
    },
    {
        "id": "63d4a278241446ae",
        "type": "function",
        "z": "618d7734aad54e6b",
        "name": "Execute Rule",
        "func": "\nconst rule = msg.rule || msg.payload;\nif (!rule) { node.warn(\"NO RULE\"); return null; }\nfunction compare(value, operator, target) {\n    if (operator === \">\") return value > target;\n    if (operator === \">=\") return value >= target;\n    if (operator === \"<\") return value < target;\n    if (operator === \"<=\") return value <= target;\n    if (operator === \"==\" || operator === \"=\") return value === target;\n    if (operator === \"!=\") return value !== target;\n    throw new Error(`Unsupported operator: ${operator}`);\n}\nfunction toNumbers(values) { return values.map(v => Number(v)).filter(v => !Number.isNaN(v) && Number.isFinite(v)); }\nfunction filterByCondition(values, condition) {\n    const match = String(condition || \"\").trim().match(/^value\\s*(>=|<=|>|<|==|=|!=)\\s*(-?\\d+(\\.\\d+)?)$/);\n    if (!match) throw new Error(`Unsupported FILTER condition: ${condition}`);\n    return values.filter(v => compare(Number(v), match[1], Number(match[2])));\n}\nfunction aggregate(values, type) {\n    const nums = toNumbers(values);\n    if (type === \"COUNT\") return nums.length;\n    if (!nums.length) throw new Error(`${type} cannot run on empty values`);\n    if (type === \"SUM\") return nums.reduce((a,b)=>a+b,0);\n    if (type === \"AVG\") return nums.reduce((a,b)=>a+b,0) / nums.length;\n    if (type === \"MIN\") return Math.min(...nums);\n    if (type === \"MAX\") return Math.max(...nums);\n    if (type === \"FIRST\") return nums[0];\n    if (type === \"LAST\") return nums[nums.length - 1];\n    throw new Error(`Unsupported aggregation: ${type}`);\n}\nfunction executePipeline(values, pipeline) {\n    let result = Array.isArray(values) ? values.slice() : [];\n    for (const step of pipeline || []) {\n        if (!step?.type) throw new Error(\"Invalid pipeline step\");\n        switch (step.type) {\n            case \"REMOVE_NULLS\": result = result.filter(v => v !== null && v !== undefined && v !== \"\" && !Number.isNaN(Number(v))); break;\n            case \"FILTER\": result = filterByCondition(result, step.condition); break;\n            case \"AVG\": case \"SUM\": case \"MIN\": case \"MAX\": case \"FIRST\": case \"LAST\": case \"COUNT\": result = aggregate(result, step.type); break;\n            default: throw new Error(`Unsupported pipeline step: ${step.type}`);\n        }\n    }\n    return result;\n}\nfunction round(value, digits=4) { return (typeof value === \"number\" && Number.isFinite(value)) ? Number(value.toFixed(digits)) : value; }\nfunction evaluateComparison(observedValue, rule) {\n    const comparison = rule.comparison; const operator = rule.operator; const expected = rule.value;\n    let actualValue = observedValue; let passed = false;\n    if (comparison === \"ABSOLUTE\") passed = compare(observedValue, operator, Number(expected));\n    else if (comparison === \"RANGE\") passed = observedValue >= Number(expected?.min) && observedValue <= Number(expected?.max);\n    else if (comparison === \"PERCENT_DECREASE_FROM_BASELINE\") {\n        const baseline = Number(rule.baseline?.value); if (!baseline || Number.isNaN(baseline)) throw new Error(`Invalid baseline for assetId=${rule.assetId}`);\n        actualValue = ((baseline - observedValue) / baseline) * 100; passed = compare(actualValue, operator || \">=\", Number(expected));\n    } else if (comparison === \"PERCENT_INCREASE_FROM_BASELINE\") {\n        const baseline = Number(rule.baseline?.value); if (!baseline || Number.isNaN(baseline)) throw new Error(`Invalid baseline for assetId=${rule.assetId}`);\n        actualValue = ((observedValue - baseline) / baseline) * 100; passed = compare(actualValue, operator || \">=\", Number(expected));\n    } else if (comparison === \"MAX_DEVIATION_FROM_BASELINE\") {\n        const baseline = Number(rule.baseline?.value); if (Number.isNaN(baseline)) throw new Error(`Invalid baseline for assetId=${rule.assetId}`);\n        actualValue = Math.abs(observedValue - baseline); passed = compare(actualValue, operator || \"<=\", Number(expected));\n    } else throw new Error(`Unsupported comparison: ${comparison}`);\n    return { passed, actualValue: round(actualValue), expectedValue: expected };\n}\ntry {\n    const pipeline = rule.aggregation?.pipeline || [{ type: \"REMOVE_NULLS\" }, { type: \"AVG\" }];\n    const observedValue = executePipeline(msg.rawValues || [], pipeline);\n    if (Array.isArray(observedValue)) throw new Error(`Pipeline ended with array for assetId=${rule.assetId}. Add final aggregation.`);\n    const comparisonResult = evaluateComparison(Number(observedValue), rule);\n    msg.ruleResult = {\n        recommendationId: msg.recommendationId, assetId: rule.assetId, window: rule.window, required: rule.required !== false,\n        passed: comparisonResult.passed, observedValue: round(Number(observedValue)), comparisonActualValue: comparisonResult.actualValue,\n        expectedValue: comparisonResult.expectedValue, comparison: rule.comparison, operator: rule.operator, baseline: rule.baseline,\n        aggregation: { pipeline, rawSampleCount: msg.sampleCount || 0, filteredRowCount: msg.assetRows?.length || 0 }, windowUsed: msg.windowUsed\n    };\n    msg.payload = msg.ruleResult;\n    node.status({ fill: comparisonResult.passed ? \"green\" : \"red\", shape: \"dot\", text: `${rule.assetId} ${comparisonResult.passed ? \"PASS\" : \"FAIL\"}` });\n    return msg;\n} catch (err) { node.error(`RULE_EXECUTION_ERROR: ${err.message}`); return null; }\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 530,
        "y": 400,
        "wires": [
