        "func": "const edgeId = global.get(\"EDGE_ID\");\nconst publicKey = global.get(\"EDGE_PUBLIC_KEY\");\nif (!edgeId || !publicKey) { node.error(\"EDGE_ID OR PUBLIC_KEY MISSING\"); return null; }\nmsg.method = \"POST\";\nmsg.url = \"https://4lvp0dw3hd.execute-api.eu-central-1.amazonaws.com/demo/mp-model-library/save-public-key\";\nmsg.headers = { \"Content-Type\": \"application/json\" };\nmsg.payload = { edgeId, keyId: `${edgeId}#v1`, publicKey, algo: \"ED25519\", registeredAt: Date.now() };\nreturn msg;",
