    {
        "id": "c12d0d5ea61645d4",
        "type": "function",
        "z": "618d7734aad54e6b",
        "name": "Sign Hash",
        "func": "const crypto = global.get(\"crypto\");\nconst privateKey = global.get(\"EDGE_PRIVATE_KEY\");\nif (!privateKey) { node.error(\"NO PRIVATE KEY\"); return null; }\nconst signature = crypto.sign(null, Buffer.from(msg.hash), privateKey);\nmsg.signature = signature.toString(\"base64\");\nreturn msg;",
