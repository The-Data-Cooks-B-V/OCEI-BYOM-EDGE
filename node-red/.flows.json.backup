    {
        "id": "f4fb356369ff58b7",
        "type": "function",
        "z": "e7008fac9d7a2047",
        "name": "Store Pending Recommendation",
        "func": "const fs = global.get(\"fs\");\nconst ai = msg.ai || msg.payload;\nconst fields = ai?.fields || ai;\nconst rec = fields?.recommendation;\nconst verification = rec?.verification;\nif (!ai || !rec || !verification) { node.warn(\"INVALID RECOMMENDATION: fields.recommendation.verification missing\"); return null; }\nconst recommendationId = msg.recommendationId || ai.recommendationId || `${ai.pk || \"PredictiveModelResult\"}#${ai.sk || Date.now()}`;\nconst startMs = Number(verification.observationWindow?.startTime);\nconst endMs = Number(verification.observationWindow?.endTime);\nif (!startMs || !endMs || Number.isNaN(startMs) || Number.isNaN(endMs) || endMs <= startMs) { node.warn(`INVALID observationWindow FOR ${recommendationId}`); return null; }\nconst now = Date.now();\nif (now >= endMs) {\n    msg.ai = ai; msg.fields = fields; msg.recommendationId = recommendationId; msg.payload = ai;\n    node.status({ fill: \"green\", shape: \"dot\", text: `due now ${recommendationId}` });\n    return msg;\n}\nconst pendingDir = \"/data/pending\";\nconst pendingPath = `${pendingDir}/pending_recommendations.json`;\nif (!fs.existsSync(pendingDir)) fs.mkdirSync(pendingDir, { recursive: true });\nlet pending = [];\nif (fs.existsSync(pendingPath)) {\n    try { pending = JSON.parse(fs.readFileSync(pendingPath, \"utf8\") || \"[]\"); } catch (err) { pending = []; }\n}\npending = pending.filter(x => x.recommendationId !== recommendationId);\npending.push({ recommendationId, pk: ai.pk, sk: ai.sk, startTime: startMs, endTime: endMs, status: \"WAITING_OBSERVATION_WINDOW_END\", receivedAt: now, ai });\npending.sort((a, b) => Number(a.endTime) - Number(b.endTime));\nfs.writeFileSync(pendingPath, JSON.stringify(pending, null, 2));\nnode.status({ fill: \"yellow\", shape: \"ring\", text: `pending ${pending.length}` });\nreturn null;",
        "outputs": 1,
        "noerr": 0,
