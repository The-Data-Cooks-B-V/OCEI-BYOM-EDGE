    {
        "id": "a2985f70639244d2",
        "type": "function",
        "z": "618d7734aad54e6b",
        "name": "Queue Or Publish",
        "func": "const fs = global.get(\"fs\");\nconst queueDir = \"/data/queue\";\nconst queuePath = `${queueDir}/pending_proofs.json`;\nif (!fs.existsSync(queueDir)) fs.mkdirSync(queueDir, { recursive: true });\nconst mqttConnected = global.get(\"MQTT_CONNECTED\");\nif (!mqttConnected) {\n    let queue = [];\n    if (fs.existsSync(queuePath)) queue = JSON.parse(fs.readFileSync(queuePath, \"utf8\") || \"[]\");\n    queue.push({ id: msg.proof?.proofId, payload: msg.payload, topic: \"ocei/demo\", queuedAt: Date.now(), retryCount: 0 });\n    fs.writeFileSync(queuePath, JSON.stringify(queue, null, 2));\n    node.status({ fill: \"yellow\", shape: \"ring\", text: `queued (${queue.length})` });\n    return null;\n}\nmsg.topic = \"ocei/demo\";\nnode.status({ fill: \"green\", shape: \"dot\", text: \"published\" });\nreturn msg;",
