            },
            {
                "name": "1VP3-ActualNitrogenRunning",
                "nodeId": "ns=5;s=HEAD_PLC.1PLC1-8.CTCompanion.CTProcessValues.1VP1-4.Process.1VP3-ActualNitrogenRunning",
