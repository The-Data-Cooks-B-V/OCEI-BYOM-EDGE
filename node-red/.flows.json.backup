    {
        "id": "33f2f5c2d8b966a5",
        "type": "function",
        "z": "e7008fac9d7a2047",
        "name": "Accumulate Rule Results",
        "func": "const recommendationId = msg.recommendationId;\nconst result = msg.ruleResult || msg.payload;\nconst ai = msg.ai || flow.get(`verify:${recommendationId}:ai`);\nif (!recommendationId || !result) { node.warn(\"MISSING recommendationId or rule result\"); return null; }\nconst keyResults = `verify:${recommendationId}:results`;\nconst keyExpected = `verify:${recommendationId}:expectedCount`;\nlet results = flow.get(keyResults) || [];\nconst expectedCount = Number(flow.get(keyExpected) || 0);\nresults = results.filter(r => !(r.assetId === result.assetId && r.comparison === result.comparison));\nresults.push(result);\nflow.set(keyResults, results);\nnode.status({ fill: \"blue\", shape: \"dot\", text: `${results.length}/${expectedCount}` });\nif (!expectedCount || results.length < expectedCount) return null;\nconst requiredResults = results.filter(r => r.required !== false);\nconst optionalResults = results.filter(r => r.required === false);\nconst verified = requiredResults.every(r => r.passed);\nmsg.ai = ai;\nmsg.recommendationId = recommendationId;\nmsg.ruleResults = results;\nmsg.verified = verified;\nmsg.observedMetrics = {};\nmsg.pipelineResults = {};\nfor (const r of results) {\n    msg.observedMetrics[r.assetId] = r.observedValue;\n    msg.pipelineResults[r.assetId] = r.aggregation;\n}\nmsg._startTime = flow.get(`verify:${recommendationId}:startTime`) || msg._startTime;\nflow.set(keyResults, []); flow.set(keyExpected, 0);\nif (!verified) {\n    node.warn({ status: \"NOT_VERIFIED\", recommendationId, requiredResults, optionalResults });\n    return null;\n}\nnode.status({ fill: \"green\", shape: \"dot\", text: `VERIFIED ${recommendationId}` });\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
