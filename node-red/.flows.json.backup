    {
        "id": "45838105010841d5",
        "type": "function",
        "z": "618d7734aad54e6b",
        "name": "Build Generic Proof",
        "func": "const crypto = global.get(\"crypto\");\nconst ai = msg.ai || {};\nconst fields = ai.fields || ai;\nconst recommendation = fields.recommendation || {};\nconst customer = global.get(\"customer\")\nif (!msg.verified) { node.warn(\"CANNOT BUILD PROOF: NOT VERIFIED\"); return null; }\n\nconst recommendationId = msg.recommendationId || ai.recommendationId ||\n    `${ai.pk || \"PredictiveModelResult\"}#${ai.sk || Date.now()}`;\nconst metadata = fields.metadata || {};\n\nconst energyRule = (msg.ruleResults || []).find(r => r.required === true);\n\nlet impact;\nconst baseline = Number(energyRule.baseline?.value ?? 0);\nconst observed = Number(energyRule.observedValue ?? 0);\nconst energyDelta = baseline - observed;\nconst percentChange = Number(energyRule.comparisonActualValue ?? 0);\nimpact = {\n    energyDelta,\n    percentChange,\n    observedValue: observed,\n    baselineValue: baseline,\n    baselineUnit: energyRule.baseline?.unit ?? null,\n    comparison: energyRule.comparison,\n};\n\n\nmsg.proof = {\n    proofId: crypto.randomUUID(),\n    edgeId: global.get(\"EDGE_ID\"),\n    recommendationId,\n    contractId: fields.contractId,\n    sourceRecord: { pk: ai.pk, sk: ai.sk },\n    customer: customer,\n    recommendation: {\n        title: recommendation.title,\n        type: recommendation.type,\n        expectedImpact: recommendation.expectedImpact,\n        actions: recommendation.actions || []\n    },\n    wallets: {\n        operatorWallet: metadata.operatorWallet,\n        modelOwnerWallet: metadata.modelOwnerWallet\n    },\n    reward: {\n        operatorPercentage: metadata.operatorPercentage,\n        modelOwnerPercentage: metadata.modelOwnerPercentage\n    },\n    verification: {\n        verificationType: recommendation.verification?.verificationType || \"EDGE_RUNTIME_PIPELINE\",\n        verified: true,\n        observationWindow: recommendation.verification?.observationWindow,\n        executionWindow: recommendation.verification?.executionWindow,\n        observedMetrics: msg.observedMetrics,\n        pipelineResults: msg.pipelineResults,\n        ruleResults: msg.ruleResults,\n        verifiedAt: Date.now()\n    },\n    impact,\n    audit: {\n        createdAt: Date.now(),\n        rawSamplesStored: false\n    }\n};\n\nreturn msg;",
        "outputs": 1,
