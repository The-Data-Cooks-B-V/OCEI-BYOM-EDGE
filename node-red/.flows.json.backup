    {
        "id": "5b1db7fc0e7c48d1",
        "type": "function",
        "z": "618d7734aad54e6b",
        "name": "Dispatch Due Recommendations",
        "func": "const fs = global.get(\"fs\");\nconst pendingPath = \"/data/pending/pending_recommendations.json\";\nif (!fs.existsSync(pendingPath)) { node.status({ fill: \"grey\", shape: \"ring\", text: \"no pending\" }); return null; }\nlet pending = [];\ntry { pending = JSON.parse(fs.readFileSync(pendingPath, \"utf8\") || \"[]\"); } catch (err) { node.error(\"FAILED TO READ pending_recommendations.json\"); return null; }\nif (!pending.length) { node.status({ fill: \"grey\", shape: \"ring\", text: \"pending empty\" }); return null; }\nconst now = Date.now();\nconst due = [], remaining = [];\nfor (const item of pending) {\n    if (Number(item.endTime) && now >= Number(item.endTime)) due.push(item); else remaining.push(item);\n}\nfs.writeFileSync(pendingPath, JSON.stringify(remaining, null, 2));\nif (!due.length) {\n    const next = remaining.filter(x => x.endTime).sort((a,b) => Number(a.endTime)-Number(b.endTime))[0];\n    if (next) node.status({ fill: \"yellow\", shape: \"ring\", text: `next due in ${Math.ceil((Number(next.endTime)-now)/60000)} min` });\n    return null;\n}\nconst messages = due.map(item => {\n    const ai = item.ai; const fields = ai?.fields || ai;\n    const recommendationId = item.recommendationId || ai?.recommendationId || `${ai?.pk || \"PredictiveModelResult\"}#${ai?.sk || Date.now()}`;\n    return { payload: ai, ai, fields, recommendationId, dispatchedAt: now };\n});\nnode.status({ fill: \"green\", shape: \"dot\", text: `dispatch ${messages.length}` });\nreturn [messages];",
