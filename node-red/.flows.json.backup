        "name": "cloud status control",
        "func": "const status = (msg.status?.text || \"\").toLowerCase();\nif (status.includes(\"connected\") && !status.includes(\"disconnected\")) {\n    global.set(\"MQTT_CONNECTED\", true);\n    node.status({ fill: \"green\", shape: \"dot\", text: \"MQTT connected\" });\n} else {\n    global.set(\"MQTT_CONNECTED\", false);\n    node.status({ fill: \"red\", shape: \"ring\", text: \"MQTT disconnected\" });\n}\nreturn null;",
