    {
        "id": "f7a400469ffa4fd6",
        "type": "function",
        "z": "618d7734aad54e6b",
        "name": "EDGE → BACKEND Payload",
        "func": "if (!msg.proof || !msg.hash || !msg.signature) { node.error(\"MISSING PROOF / HASH / SIGNATURE\"); return null; }\nmsg.payload = JSON.stringify({ proof: msg.proof, hash: msg.hash, signature: msg.signature, edgeId: global.get(\"EDGE_ID\"), algo: \"ED25519\", createdAt: Date.now() });\nreturn msg;",
