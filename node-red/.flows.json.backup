        "z": "618d7734aad54e6b",
        "name": "Retry One Pending Proof",
        "func": "const fs = global.get(\"fs\");\nconst queuePath = \"/data/queue/pending_proofs.json\";\nconst mqttConnected = global.get(\"MQTT_CONNECTED\");\nif (!mqttConnected) { node.status({ fill: \"red\", shape: \"ring\", text: \"MQTT offline\" }); return null; }\nif (!fs.existsSync(queuePath)) { node.status({ fill: \"grey\", shape: \"ring\", text: \"queue empty\" }); return null; }\nlet queue = JSON.parse(fs.readFileSync(queuePath, \"utf8\") || \"[]\");\nif (!queue.length) { node.status({ fill: \"grey\", shape: \"ring\", text: \"queue empty\" }); return null; }\nconst item = queue.shift();\nfs.writeFileSync(queuePath, JSON.stringify(queue, null, 2));\nnode.status({ fill: \"green\", shape: \"dot\", text: `retrying 1, left ${queue.length}` });\nreturn { payload: item.payload, topic: item.topic || \"ocei/demo\" };",
