    {
        "id": "e569f46f9f6c4cbd",
        "type": "function",
        "z": "618d7734aad54e6b",
        "name": "SHA256 Hash",
        "func": "const crypto = global.get(\"crypto\");\nconst proofString = JSON.stringify(msg.proof);\nmsg.hash = crypto.createHash(\"sha256\").update(proofString).digest(\"hex\");\nreturn msg;",
        "outputs": 1,
