                "6a9848c4015456aa"
            ]
        ]
    },
    {
        "id": "6a9848c4015456aa",
        "type": "function",
        "z": "e7008fac9d7a2047",
        "name": "Split Verification Rules",
        "func": "const ai = msg.ai || msg.payload;\nconst fields = msg.fields || ai?.fields || ai;\nconst rules = fields?.recommendation?.verification?.rules || [];\nif (!Array.isArray(rules) || !rules.length) { node.warn(\"NO verification.rules FOUND\"); return null; }\nconst recommendationId = msg.recommendationId || ai?.recommendationId || `${ai?.pk || \"PredictiveModelResult\"}#${ai?.sk || Date.now()}`;\nflow.set(`verify:${recommendationId}:expectedCount`, rules.length);\nflow.set(`verify:${recommendationId}:results`, []);\nflow.set(`verify:${recommendationId}:ai`, ai);\nflow.set(`verify:${recommendationId}:startTime`, msg._startTime || Date.now());\nconst messages = rules.map((rule, index) => ({ payload: rule, ai, fields, rule, ruleIndex: index, ruleCount: rules.length, recommendationId, _startTime: msg._startTime }));\nnode.status({ fill: \"green\", shape: \"dot\", text: `${rules.length} rules` });\nreturn [messages];",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
