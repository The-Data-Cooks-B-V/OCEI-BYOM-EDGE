    {
        "id": "f084961527998358",
        "type": "json",
        "z": "6d4d2aa19f0a5553",
        "name": "",
        "property": "payload",
        "action": "",
        "pretty": false,
        "x": 910,
        "y": 80,
        "wires": [
            [
