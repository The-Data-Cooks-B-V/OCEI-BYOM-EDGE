    {
        "id": "5aa3adaa1551183f",
        "type": "function",
        "z": "6d4d2aa19f0a5553",
        "name": "Format All Tags for 5vp",
        "func": "// --- Giriş payload'unu normalize et ---\nconst payloadArray = Array.isArray(msg.payload.buffer)\n  ? msg.payload.buffer\n  : Array.isArray(msg.payload)\n    ? msg.payload\n    : [msg.payload];\n\n// --- Yardımcılar ---\nconst normalize = s => (s || \"\")\n  .toLowerCase()\n  .replace(/[-_.\\s]/g, \"\")\n  .replace(/(vp)0+(\\d)/g, \"$1$2\"); // 5vp01 -> 5vp1\n\nconst toNum = v => (typeof v === \"boolean\" ? (v ? 1 : 0) : Number(v));\nconst last = arr => (Array.isArray(arr) && arr.length ? arr[arr.length - 1] : undefined);\nconst toFixedStr = n => Number(n).toFixed(2);\n\n// --- Sabitler ---\nconst result = [];\nconst assetMap = (flow.get(\"assetMap\") || {}).assets || {};\nconst customerId = flow.get(\"customerId\") || \"0\";\nconst clientId = flow.get(\"clientId\") || \"0\";\nconst startTime = Number.isFinite(msg.payload.startTime) ? msg.payload.startTime : Math.floor(Date.now() / 1000);\nconst endTime   = Number.isFinite(msg.payload.endTime)   ? msg.payload.endTime   : null;\nconst includeEndTime = Number.isFinite(endTime);\n\nconst singleTags = [\"cycleisrunning\", \"flag\"];\nconst groupedData = {};\n\nlet prefix = null;\nlet pressureValues = [];\nlet steamMask = [];\nlet nitrogenMask = [];\n\n// 5VP delta sayaçları\nlet lastSteamTime = 0;\nlet lastNitrogenTime = 0;\n\n// --- Ana döngü ---\nfor (const data of payloadArray) {\n  const values = data.value?.results;\n  const tags   = data.addressSpaceItems;\n  const meta   = data.meta || {};\n  if (!Array.isArray(values) || !Array.isArray(tags)) continue;\n\n  // Prefix (5VP01 -> 5VP1)\n  if (!prefix && tags.length > 0) {\n    const raw = tags[0].name || \"\";\n    const m = raw.match(/(\\d+VP\\d+)/i);\n    prefix = m ? normalize(m[1]).toUpperCase() : null; // \"5VP1\"\n  }\n\n  // --- Pressure ve Time fallback toplama ---\n  let samplePressures = [];\n  let tagSteamTime = null;\n  let tagNitrogenTime = null;\n\n  for (let i = 0; i < tags.length; i++) {\n    const tName = normalize(tags[i]?.name);\n    const valRaw = values[i]?.value;\n    const arr = Array.isArray(valRaw) ? valRaw : [valRaw];\n    const v = last(arr);\n    const num = toNum(v);\n\n    if (tName.endsWith(\"actualpressureinside\")) {\n      if (Number.isFinite(num)) samplePressures.push(num === 65535 ? \"0.00\" : toFixedStr(num));\n    } else if (tName.endsWith(\"actualsteamtime\")) {\n      if (Number.isFinite(num)) tagSteamTime = (num === 65535 ? 0 : num);\n    } else if (tName.endsWith(\"actualnitrogentime\")) {\n      if (Number.isFinite(num)) tagNitrogenTime = (num === 65535 ? 0 : num);\n    }\n  }\n\n  // meta’dan tekil pressure varsa\n  let metaPressure = null;\n  if (meta.pressure !== undefined && meta.pressure !== null) {\n    const mp = toNum(meta.pressure);\n    if (Number.isFinite(mp)) metaPressure = (mp === 65535) ? \"0.00\" : toFixedStr(mp);\n  }\n  // garanti fallback\n  const finalPressure = metaPressure !== null ? metaPressure : (samplePressures[0] ?? null);\n  const fp = (finalPressure == null) ? \"0.00\" : finalPressure;\n\n  // Etkili süre: meta (Buffer’dan) öncelikli, yoksa tag\n  const stEff = Number.isFinite(toNum(meta.steamTime))    ? toNum(meta.steamTime)    : (Number.isFinite(tagSteamTime)    ? tagSteamTime    : 0);\n  const ntEff = Number.isFinite(toNum(meta.nitrogenTime)) ? toNum(meta.nitrogenTime) : (Number.isFinite(tagNitrogenTime) ? tagNitrogenTime : 0);\n\n  // Delta: arttı mı?\n  const grewSteam    = stEff > lastSteamTime;\n  const grewNitrogen = ntEff > lastNitrogenTime;\n\n  // Maskeler\n  pressureValues.push(fp);\n  steamMask.push(grewSteam ? fp : \"0.00\");\n  nitrogenMask.push(grewNitrogen ? fp : \"0.00\");\n\n  // sayaçları güncelle\n  lastSteamTime = stEff;\n  lastNitrogenTime = ntEff;\n\n  // --- Diğer tagların cycle değerleri ---\n  for (let i = 0; i < values.length; i++) {\n    const tagNameRaw = tags[i]?.name || \"\";\n    const tagName = normalize(tagNameRaw);\n    const valRaw = values[i]?.value;\n    if (valRaw === undefined || valRaw === null) continue;\n\n    const v = Array.isArray(valRaw) ? last(valRaw) : valRaw;\n    const numericVal = toNum(v);\n    if (!Number.isFinite(numericVal)) continue;\n\n    const finalValNum = (numericVal === 65535) ? 0.00 : numericVal;\n    const finalValStr = toFixedStr(finalValNum);\n\n    const keyMatch = Object.keys(assetMap).find(k => normalize(k) === tagName);\n    if (!keyMatch) continue;\n\n    const asset_id = assetMap[keyMatch];\n    const isSingle = singleTags.some(t => tagName.includes(t));\n\n    if (isSingle) {\n      result.push({\n        asset_id,\n        val: finalValStr,\n        customer_id: customerId,\n        client_id: clientId,\n        timestamp: startTime,\n        ttl: startTime + 94608000\n      });\n    } else {\n      if (!groupedData[asset_id]) groupedData[asset_id] = [];\n      groupedData[asset_id].push(finalValStr);\n    }\n  }\n}\n\n// --- Cycle verilerini ekle ---\nfor (const asset_id in groupedData) {\n  const rec = {\n    asset_id,\n    val: groupedData[asset_id],\n    customer_id: customerId,\n    client_id: clientId,\n    timestamp: startTime,\n    ttl: startTime + 94608000\n  };\n  if (includeEndTime) rec.endTime = endTime;\n  result.push(rec);\n}\n\n// --- Steam/Nitrogen basınçlarını ekle ---\nif (prefix && pressureValues.length > 0) {\n  const steamAsset    = assetMap[`${prefix}-ActualSteamPressure`];\n  const nitrogenAsset = assetMap[`${prefix}-ActualNitrogenPressure`];\n\n  if (steamAsset) {\n    const rec = {\n      asset_id: steamAsset,\n      val: steamMask,\n      customer_id: customerId,\n      client_id: clientId,\n      timestamp: startTime,\n      ttl: startTime + 94608000\n    };\n    if (includeEndTime) rec.endTime = endTime;\n    result.push(rec);\n  }\n  if (nitrogenAsset) {\n    const rec = {\n      asset_id: nitrogenAsset,\n      val: nitrogenMask,\n      customer_id: customerId,\n      client_id: clientId,\n      timestamp: startTime,\n      ttl: startTime + 94608000\n    };\n    if (includeEndTime) rec.endTime = endTime;\n    result.push(rec);\n  }\n}\n\nreturn [{ topic: \"Conti-TEST\", payload: result }];\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
