    {
        "id": "bb7f28c811382324",
        "type": "function",
        "z": "e7008fac9d7a2047",
        "name": "Build Generic Proof",
        "func": "const crypto = global.get(\"crypto\");\nconst ai = msg.ai || {};\nconst fields = ai.fields || ai;\nconst recommendation = fields.recommendation || {};\nif (!msg.verified) { node.warn(\"CANNOT BUILD PROOF: NOT VERIFIED\"); return null; }\nconst recommendationId = msg.recommendationId || ai.recommendationId || `${ai.pk || \"PredictiveModelResult\"}#${ai.sk || Date.now()}`;\nconst metadata = fields.metadata || {};\nmsg.proof = {\n    proofId: crypto.randomUUID(), edgeId: global.get(\"EDGE_ID\"), recommendationId, contractId: fields.contractId,\n    sourceRecord: { pk: ai.pk, sk: ai.sk },\n    recommendation: { title: recommendation.title, type: recommendation.type, expectedImpact: recommendation.expectedImpact, actions: recommendation.actions || [] },\n    wallets: { operatorWallet: metadata.operatorWallet, modelOwnerWallet: metadata.modelOwnerWallet },\n    reward: { operatorPercentage: metadata.operatorPercentage, modelOwnerPercentage: metadata.modelOwnerPercentage },\n    verification: { verificationType: recommendation.verification?.verificationType || \"EDGE_RUNTIME_PIPELINE\", verified: true, observationWindow: recommendation.verification?.observationWindow, executionWindow: recommendation.verification?.executionWindow, observedMetrics: msg.observedMetrics, pipelineResults: msg.pipelineResults, ruleResults: msg.ruleResults, verifiedAt: Date.now() },\n    audit: { createdAt: Date.now(), rawSamplesStored: false }\n};\nreturn msg;",
        "outputs": 1,
