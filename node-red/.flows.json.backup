    {
        "id": "84163955d639c54e",
        "type": "function",
        "z": "6d4d2aa19f0a5553",
        "name": "function 8",
        "func": "var timestamp = Math.floor(Date.now() / 1000);\n\n// Şu anki flow değişkenlerini al\nvar sc1 = flow.get(\"server_connection_1\");\nvar sc2 = flow.get(\"server_connection_2\");\nvar sc3 = flow.get(\"server_connection_3\");\n\n// Eski flow değişkenlerini al\nvar sc1_old = flow.get(\"server_connection_1_old\");\nvar sc2_old = flow.get(\"server_connection_2_old\");\nvar sc3_old = flow.get(\"server_connection_3_old\");\n\n// Durum değişkenleri\nvar server_1=1;\nvar server_2=1;\nvar server_3=1;\n\n// Eğer eski değerler tanımlı değilse, yeni değerleri atayalım\nif (sc1_old === undefined) {\n    flow.set(\"server_connection_1_old\", sc1);\n} else {\n    // sc1 ile sc1_old'u karşılaştır\n    if (sc1 == sc1_old) {\n        // Veri geldiyse değişmiş olmalı\n        node.warn(\"server_connection_1'e 2 dakikadır veri gelmemiş!\");\n        server_1=0;\n    } else {\n        flow.set(\"server_connection_1_old\", sc1);\n    }\n}\n    // Eğer eski değerler tanımlı değilse, yeni değerleri atayalım\nif (sc2_old === undefined) {\n    flow.set(\"server_connection_2_old\", sc2);\n} else {\n    // sc2 ile sc2_old'u karşılaştır\n    if (sc2 == sc2_old) {\n        // Veri geldiyse değişmiş olmalı\n        node.warn(\"server_connection_2'ye 2 dakikadır veri gelmemiş!!\");\n        server_2 = 0;\n    } else {\n        flow.set(\"server_connection_2_old\", sc2);\n    }\n}\n    // Eğer eski değerler tanımlı değilse, yeni değerleri atayalım\nif (sc3_old === undefined) {\n    flow.set(\"server_connection_3_old\", sc3);\n} else {\n    // sc3 ile sc3_old'u karşılaştır\n    if (sc3 == sc3_old) {\n        // Veri geldiyse değişmiş olmalı\n        node.warn(\"server_connection_3'e 2 dakikadır veri gelmemiş!!\");\n        server_3 = 0;\n    } else {\n        flow.set(\"server_connection_3_old\", sc3);\n    }\n}\n\nif (server_1 === 0 || server_2 === 0 || server_3 === 0) {\n    msg.payload = {\n        \"asset_id\": \"1751894921318\", \n        \"timestamp\": timestamp,\n        \"customer_id\": \"16\",\n        \"val\": 0\n    };\n    return msg; // Fabmetricse alarm gonderir.\n} else {\n    msg.payload = {\n        \"asset_id\": \"1751894921318\",\n        \"timestamp\": timestamp,\n        \"customer_id\": \"16\",\n        \"val\": 1\n    };\n    return msg; // Normal sinyal gönderir\n}\n",
