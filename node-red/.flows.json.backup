    {
        "id": "68ff7d040a79ff10",
        "type": "function",
        "z": "e7008fac9d7a2047",
        "name": "Split Recommendations",
        "func": "const response = msg.payload;\nnode.warn(response);\nconst list = Array.isArray(response?.data) ? response.data : Array.isArray(response) ? response : response ? [response] : [];\nif (!list.length) { node.warn(\"NO RECOMMENDATIONS FOUND\"); return null; }\nconst messages = list.map(item => {\n    const ai = item;\n    const fields = ai.fields || ai;\n    const recommendationId = ai.recommendationId || `${ai.pk || \"PredictiveModelResult\"}#${ai.sk || Date.now()}`;\n    return { payload: ai, ai, fields, recommendationId, _startTime: msg._startTime };\n});\nnode.status({ fill: \"green\", shape: \"dot\", text: `${messages.length} recommendations` });\nreturn [messages];",
        "outputs": 1,
