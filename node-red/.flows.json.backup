    {
        "id": "96fd7a71acfc1c20",
        "type": "function",
        "z": "e7008fac9d7a2047",
        "name": "ED25519 Init",
        "func": "const fs = global.get(\"fs\");\nconst crypto = global.get(\"crypto\");\nconst keyDir = \"/data/keys\";\nconst privPath = keyDir + \"/edge_private.pem\";\nconst pubPath = keyDir + \"/edge_public.pem\";\nif (!fs.existsSync(keyDir)) fs.mkdirSync(keyDir, { recursive: true });\nlet privatePem, publicPem;\nif (!fs.existsSync(privPath)) {\n    const { publicKey, privateKey } = crypto.generateKeyPairSync(\"ed25519\");\n    privatePem = privateKey.export({ type: \"pkcs8\", format: \"pem\" });\n    publicPem = publicKey.export({ type: \"spki\", format: \"pem\" });\n    fs.writeFileSync(privPath, privatePem);\n    fs.writeFileSync(pubPath, publicPem);\n    node.warn(\"ED25519 keys generated\");\n} else {\n    privatePem = fs.readFileSync(privPath, \"utf8\");\n    publicPem = fs.readFileSync(pubPath, \"utf8\");\n    node.warn(\"ED25519 keys loaded\");\n}\nglobal.set(\"EDGE_PRIVATE_KEY\", privatePem);\nglobal.set(\"EDGE_PUBLIC_KEY\", publicPem);\nreturn msg;",
