    {
        "id": "41b5a813f91640ce",
        "type": "inject",
        "z": "618d7734aad54e6b",
        "name": "Startup - Init Edge",
        "props": [
            {
                "p": "payload"
            },
            {
                "p": "topic",
                "vt": "str"
            }
        ],
        "repeat": "",
        "crontab": "",
        "once": true,
        "onceDelay": "0.5",
        "topic": "",
        "payload": "",
