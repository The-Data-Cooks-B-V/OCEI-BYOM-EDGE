    {
        "id": "5dd753fdaf7f68ec",
        "type": "function",
        "z": "863be1bd35fec7b8",
        "name": "Generate Sample",
        "func": "\nconst ts = Math.floor(Date.now() / 1000);\nconst energy_kwh = Number((0.5 + Math.random() * 1.5).toFixed(4));\n\nmsg.payload = { data: [ { ts, energy_kwh } ] };\n\nnode.status({ fill: \"grey\", shape: \"ring\", text: `${energy_kwh} kWh @ ${new Date(ts*1000).toLocaleTimeString()}` });\nreturn msg;",
        "outputs": 1,
        "timeout": "",
