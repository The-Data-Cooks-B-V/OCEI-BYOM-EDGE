    },
    {
        "id": "6315f43a28dc4da4",
        "type": "function",
        "z": "618d7734aad54e6b",
        "name": "ED25519 Init",
        "func": "const fs = global.get(\"fs\");\nconst crypto = global.get(\"crypto\");\nconst keyDir = \"/data/keys\";\nconst privPath = keyDir + \"/edge_private.pem\";\nconst pubPath = keyDir + \"/edge_public.pem\";\nif (!fs.existsSync(keyDir)) fs.mkdirSync(keyDir, { recursive: true });\nlet privatePem, publicPem;\nif (!fs.existsSync(privPath)) {\n    const { publicKey, privateKey } = crypto.generateKeyPairSync(\"ed25519\");\n    privatePem = privateKey.export({ type: \"pkcs8\", format: \"pem\" });\n    publicPem = publicKey.export({ type: \"spki\", format: \"pem\" });\n    fs.writeFileSync(privPath, privatePem);\n    fs.writeFileSync(pubPath, publicPem);\n    node.warn(\"ED25519 keys generated\");\n} else {\n    privatePem = fs.readFileSync(privPath, \"utf8\");\n    publicPem = fs.readFileSync(pubPath, \"utf8\");\n    node.warn(\"ED25519 keys loaded\");\n}\nglobal.set(\"EDGE_PRIVATE_KEY\", privatePem);\nglobal.set(\"EDGE_PUBLIC_KEY\", publicPem);\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 370,
        "y": 20,
        "wires": [
            [
                "50f5f13f5b1143fb"
            ]
        ]
    },
    {
        "id": "50f5f13f5b1143fb",
        "type": "function",
        "z": "618d7734aad54e6b",
        "name": "Assign Edge Id",
        "func": "const edgeId = \"edge_Netherlands_1\";\nglobal.set(\"EDGE_ID\", edgeId);\nnode.status({ fill: \"green\", shape: \"dot\", text: `READY: ${edgeId}` });\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 590,
        "y": 20,
        "wires": [
            [
                "ae4ec156491749c3"
            ]
        ]
    },
    {
        "id": "ae4ec156491749c3",
        "type": "function",
        "z": "618d7734aad54e6b",
        "name": "Register Edge Public Key",
        "func": "const edgeId = global.get(\"EDGE_ID\");\nconst publicKey = global.get(\"EDGE_PUBLIC_KEY\");\nif (!edgeId || !publicKey) { node.error(\"EDGE_ID OR PUBLIC_KEY MISSING\"); return null; }\nmsg.method = \"POST\";\nmsg.url = \"https://4lvp0dw3hd.execute-api.eu-central-1.amazonaws.com/demo/mp-model-library/save-public-key\";\nmsg.headers = { \"Content-Type\": \"application/json\" };\nmsg.payload = { edgeId, keyId: `${edgeId}#v1`, publicKey, algo: \"ED25519\", registeredAt: Date.now() };\nreturn msg;",
