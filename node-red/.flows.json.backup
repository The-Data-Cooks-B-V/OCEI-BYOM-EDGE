    {
        "id": "b4f7b9b6d3e14cc1",
        "type": "inject",
        "z": "c9a2b2a2a0d14c01",
        "name": "Hourly Energy Poll",
        "props": [
            {
                "p": "payload"
            }
        ],
        "repeat": "3600",
        "crontab": "",
        "once": true,
        "onceDelay": "1",
        "topic": "",
        "payload": "",
        "payloadType": "date",
        "x": 160,
        "y": 120,
        "wires": [
            [
                "bd0c84ef0dbb4115"
            ]
        ]
    },
    {
        "id": "bd0c84ef0dbb4115",
        "type": "function",
        "z": "c9a2b2a2a0d14c01",
        "name": "Set Energy Asset Mapping",
        "func": "// This is the only place in this flow that knows the datasource mapping.\n// Verification flow will not know REST/MQTT/OPCUA/MODBUS.\n\nmsg.assetMapping = {\n    assetId: \"1780305924234\",\n    customerId: 71,\n\n    source: \"REST_ENERGY_HOURLY\",\n    type: \"REST\",\n    endpoint: \"http://37.60.249.48:8000/api/v1/energy/hourly\",\n    method: \"GET\",\n\n    responsePath: \"data\",\n    timestampField: \"ts\",\n    valueField: \"energy_kwh\",\n    unit: \"kWh\",\n\n    sourceDeviceId: \"15\",\n    query: {\n        startDateParam: \"start_date\",\n        endDateParam: \"end_date\",\n        sourceDeviceParam: \"datasource_id\",\n        page: 1,\n        pageSize: 100\n    },\n\n    headers: {\n        \"x-api-key\": \"avRQa_Jf16np\"\n    }\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 180,
        "y": 180,
        "wires": [
            [
                "a6f8c31e6c7a4d3d"
            ]
        ]
    },
    {
        "id": "a6f8c31e6c7a4d3d",
        "type": "function",
        "z": "c9a2b2a2a0d14c01",
        "name": "Build Energy REST Request",
        "func": "const mapping = msg.assetMapping;\n\nif (!mapping?.endpoint) {\n    node.warn(\"assetMapping.endpoint missing\");\n    return null;\n}\n\nfunction formatLocalDate(ms) {\n    return new Intl.DateTimeFormat(\"en-CA\", {\n        timeZone: \"Europe/Istanbul\",\n        year: \"numeric\",\n        month: \"2-digit\",\n        day: \"2-digit\"\n    }).format(new Date(ms));\n}\n\nfunction addDays(ms, days) {\n    return ms + days * 24 * 60 * 60 * 1000;\n}\n\nconst startTime = new Date(\"2026-04-01\").getTime();\nconst endTime = new Date(\"2026-04-14\").getTime();\nconst startMs = startTime\nconst endMs = endTime\n\nconst query = mapping.query || {};\nconst startDateParam = query.startDateParam || \"start_date\";\nconst endDateParam = query.endDateParam || \"end_date\";\nconst sourceDeviceParam = query.sourceDeviceParam || \"datasource_id\";\nconst page = query.page || 1;\nconst pageSize = query.pageSize || 100;\n\nconst params = new URLSearchParams();\nparams.set(startDateParam, formatLocalDate(startMs));\nparams.set(endDateParam, formatLocalDate(addDays(endMs, 1)));\nparams.set(sourceDeviceParam, String(mapping.sourceDeviceId));\nparams.set(\"page\", String(page));\nparams.set(\"page_size\", String(pageSize));\n\nif (query.extra && typeof query.extra === \"object\") {\n    for (const [key, value] of Object.entries(query.extra)) {\n        params.set(key, String(value));\n    }\n}\n\nmsg.url = `${mapping.endpoint}?${params.toString()}`;\nmsg.method = mapping.method || \"GET\";\nmsg.headers = mapping.headers || {};\n\nnode.status({ fill: \"blue\", shape: \"dot\", text: `GET energy ${mapping.assetId}` });\nnode.warn({ branch: \"ENERGY_REST\", assetId: mapping.assetId, url: msg.url });\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 180,
        "y": 240,
        "wires": [
            [
                "e104fed5df68441a"
            ]
        ]
    },
    {
        "id": "e104fed5df68441a",
        "type": "http request",
        "z": "c9a2b2a2a0d14c01",
        "name": "GET Energy Hourly REST",
        "method": "use",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "authType": "",
        "senderr": false,
        "headers": [],
        "x": 170,
        "y": 300,
        "wires": [
            [
                "a76d7cfb40494907"
            ]
        ]
    },
    {
        "id": "a76d7cfb40494907",
        "type": "function",
        "z": "c9a2b2a2a0d14c01",
        "name": "Normalize Energy + Cache + Build Backend Payload",
        "func": "const mapping = msg.assetMapping;\nif (!mapping?.assetId) {\n    node.warn(\"assetMapping.assetId missing\");\n    return null;\n}\n\nfunction getRowsByPath(payload, path) {\n    if (!path) return payload;\n    return String(path).split(\".\").reduce((acc, key) => {\n        if (acc && acc[key] !== undefined) return acc[key];\n        return undefined;\n    }, payload);\n}\n\nfunction toMillis(rawTs) {\n    if (rawTs === null || rawTs === undefined || rawTs === \"\") return NaN;\n\n    if (typeof rawTs === \"number\") {\n        // If timestamp is seconds, convert to ms. If already ms, keep it.\n        return rawTs < 100000000000 ? rawTs * 1000 : rawTs;\n    }\n\n    const numeric = Number(rawTs);\n    if (!Number.isNaN(numeric) && Number.isFinite(numeric)) {\n        return numeric < 100000000000 ? numeric * 1000 : numeric;\n    }\n\n    return new Date(rawTs).getTime();\n}\n\nconst rowsCandidate = getRowsByPath(msg.payload, mapping.responsePath || \"data\");\nconst rows =\n    Array.isArray(rowsCandidate) ? rowsCandidate :\n    Array.isArray(msg.payload?.data) ? msg.payload.data :\n    Array.isArray(msg.payload?.items) ? msg.payload.items :\n    Array.isArray(msg.payload?.data?.items) ? msg.payload.data.items :\n    [];\n\nif (!rows.length) {\n    node.warn(\"NO ENERGY ROWS FROM REST API\");\n    return null;\n}\n\nconst tsField = mapping.timestampField || \"ts\";\nconst valueField = mapping.valueField || \"energy_kwh\";\n\nconst samples = rows\n    .map(r => {\n        const ts = toMillis(r[tsField]);\n        const value = Number(r[valueField]);\n\n        if (!ts || Number.isNaN(ts) || Number.isNaN(value) || !Number.isFinite(value)) {\n            return null;\n        }\n\n        return {\n            ts,\n            value,\n            assetId: mapping.assetId,\n            customerId: mapping.customerId,\n            unit: mapping.unit,\n            sourceDeviceId: mapping.sourceDeviceId,\n            source: mapping.source,\n            rawTimestamp: r[tsField]\n        };\n    })\n    .filter(Boolean)\n    .sort((a, b) => a.ts - b.ts);\n\nif (!samples.length) {\n    node.warn(`NO VALID ENERGY SAMPLES field=${valueField}`);\n    return null;\n}\n\n\nconst cacheKey = `assetSamples:${mapping.assetId}`;\nconst now = Date.now();\nconst maxAgeMs = 90 * 24 * 60 * 60 * 1000;\nconst existing = flow.get(cacheKey) || global.get(cacheKey) || [];\nconst byTs = new Map();\n\nfor (const s of existing) {\n    if (s?.ts && now - Number(s.ts) <= maxAgeMs) {\n        byTs.set(Number(s.ts), s);\n    }\n}\n\nfor (const s of samples) {\n    if (now - Number(s.ts) <= maxAgeMs) {\n        byTs.set(Number(s.ts), s);\n    }\n}\n\nconst merged = Array.from(byTs.values()).sort((a, b) => Number(a.ts) - Number(b.ts));\nflow.set(cacheKey, merged);\nglobal.set(cacheKey, merged);\n\nconst oneYearSeconds = 365 * 24 * 60 * 60;\nconst backendRecords = samples.map(s => {\n    const timestampSeconds = Math.floor(Number(s.ts) / 1000);\n    return {\n        asset_id: mapping.assetId,\n        timestamp: timestampSeconds,\n        customer_id: mapping.customerId || 71,\n        ttl: timestampSeconds + oneYearSeconds,\n        val: s.value\n    };\n});\n\nmsg.backendRecords = backendRecords;\nmsg.normalizedPayload = backendRecords;\nmsg.payload = backendRecords;\n\nnode.status({\n    fill: \"green\",\n    shape: \"dot\",\n    text: `${mapping.assetId} cached=${merged.length} post=${backendRecords.length}`\n});\n\nnode.warn({\n    status: \"ENERGY_NORMALIZED\",\n    assetId: mapping.assetId,\n    cacheKey,\n    fetchedRows: rows.length,\n    validSamples: samples.length,\n    cachedSamples: merged.length,\n    samplePayload: backendRecords[backendRecords.length - 1]\n});\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 240,
        "y": 360,
        "wires": [
            [
                "ed01fa2bfda74ec9",
                "d4300fe7bd6f0db6"
            ]
        ]
    },
    {
        "id": "ed01fa2bfda74ec9",
        "type": "debug",
        "z": "c9a2b2a2a0d14c01",
        "name": "Cached + Normalized Records",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "normalizedPayload",
        "targetType": "msg",
        "statusVal": "",
        "statusType": "auto",
        "x": 710,
        "y": 400,
        "wires": []
    },
