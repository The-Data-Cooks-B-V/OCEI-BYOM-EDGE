        "name": "Buffer Control 5VP8",
        "func": "const results = msg.payload?.value?.results || [];\n\nconst PREFIX        = \"5VP8\";\nconst cycleKey      = `${PREFIX}-CycleIsRunning`;\nconst flagKey       = `${PREFIX}-Flag`;\nconst steamTimeKey  = `${PREFIX}-ActualSteamTime`;\nconst nitroTimeKey  = `${PREFIX}-ActualNitrogenTime`;\nconst pressKey      = `${PREFIX}-ActualPressureInside`;\n\nconst bufferKey = `buffer_${PREFIX}`;\nconst timeKey   = `time_${PREFIX}`;\n\n// --- Helpers ---\nconst scalar = v => (Array.isArray(v) ? v[v.length - 1] : v);\nconst getVal = k => {\n  const hit = results.find(r => r?.nodeId?.endsWith(k));\n  return hit ? scalar(hit.value) : undefined;\n};\nconst toNum = v => (typeof v === \"boolean\" ? (v ? 1 : 0) : Number(v));\nconst toBool = v => {\n  if (typeof v === \"boolean\") return v;\n  if (v === 1 || v === \"1\") return true;\n  if (v === 0 || v === \"0\") return false;\n  if (typeof v === \"string\") {\n    const s = v.trim().toLowerCase();\n    if (s === \"true\")  return true;\n    if (s === \"false\") return false;\n  }\n  return null; // bilinmiyor\n};\nconst clip65535 = n => (n === 65535 ? 0 : n);\n\n// --- Read & normalize ---\nconst currVal  = toBool(getVal(cycleKey));\nconst flagVal  = toBool(getVal(flagKey));\nconst steamT   = clip65535(toNum(getVal(steamTimeKey)));\nconst nitroT   = clip65535(toNum(getVal(nitroTimeKey)));\nconst pTmp     = toNum(getVal(pressKey));\nconst pressure = Number.isFinite(pTmp) ? clip65535(pTmp) : null;\n\n// --- State ---\nlet buffer = flow.get(bufferKey) || [];\nlet times  = flow.get(timeKey)   || {};\n\n// Cycle tipi okunamadıysa atla\nif (currVal === null) return null;\n\n// --- CYCLE ENDED -> flush ---\nif (currVal === false) {\n  if (buffer.length > 0) {\n    times.endTime = Date.now();\n    if (!times.startTime || times.endTime <= times.startTime) {\n      // güvenlik: start yoksa en az 1ms'lik pencere oluştur\n      times.startTime = times.startTime || (Date.now() - 1);\n      times.endTime   = times.startTime + 1;\n    }\n    const startTs = Math.floor(times.startTime / 1000);\n    const endTs   = Math.floor(times.endTime   / 1000);\n\n    // her entry'e aynı cycle başlangıcını yaz\n    buffer.forEach(e => { e.timestamp = startTs; });\n\n    msg.payload = { buffer, startTime: startTs, endTime: endTs };\n\n    // reset\n    flow.set(bufferKey, []);\n    flow.set(timeKey,   {});\n\n    node.status({ fill: \"blue\", shape: \"dot\", text: \"Buffer sent\" });\n    return msg;\n  }\n  return null;\n}\n\n// --- CYCLE RUNNING -> örnek al ---\n// flag=1 ise örnek alma (startTime da başlatma)\nif (flagVal === true) return null;\n\n// veri toplayacaksan startTime başlat\nif (!times.startTime || buffer.length === 0) {\n  times.startTime = Date.now();\n  flow.set(timeKey, times);\n}\n\n// entry\nconst entry = {\n  ...msg.payload, // addressSpaceItems + value.results aynen korunur\n  meta: {\n    // 5VP mantığı: Time > 0 -> running\n    steamTime:          Number.isFinite(steamT) ? steamT : 0,\n    nitrogenTime:       Number.isFinite(nitroT) ? nitroT : 0,\n    steamIsRunning:     Number.isFinite(steamT) && steamT  > 0,\n    nitrogenIsRunning:  Number.isFinite(nitroT) && nitroT  > 0,\n    pressure:           pressure,   // Format node'da fallback var\n    capturedAt:         Date.now()\n  }\n};\n\nbuffer.push(entry);\nflow.set(bufferKey, buffer);\n\nnode.status({ fill: \"green\", shape: \"dot\", text: `Buffering (${buffer.length})` });\nreturn null;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 900,
        "y": 2020,
        "wires": [
            [
                "5aa3adaa1551183f"
            ]
        ]
    },
    {
        "id": "69455c6533d8163b",
        "type": "function",
        "z": "6d4d2aa19f0a5553",
        "name": "Buffer Control 6VP1",
        "func": "const results = msg.payload?.value?.results || [];\nconst PREFIX = \"6VP1\";\nconst cycleKey = `${PREFIX}-CycleIsRunning`;\nconst flagKey = `${PREFIX}-Flag`;\nconst steamKey = `${PREFIX}-ActualSteamIsRunning`;\nconst nitrogenKey = `${PREFIX}-ActualNitrogenRunning`;\nconst pressureKey = `${PREFIX}-ActualPressureInside`;\n\nconst bufferKey = `buffer_${PREFIX}`;\nconst timeKey = `time_${PREFIX}`;\n\n// helpers\nconst scalar = v => (Array.isArray(v) ? v[v.length - 1] : v);\nconst getVal = key => scalar(results.find(r => r.nodeId?.endsWith(key))?.value);\nconst toNum = v => (typeof v === \"boolean\" ? (v ? 1 : 0) : Number(v));\nconst toBool = v => {\n  if (typeof v === \"boolean\") return v;\n  if (v === 1 || v === \"1\") return true;\n  if (v === 0 || v === \"0\") return false;\n  if (typeof v === \"string\") {\n    const s = v.trim().toLowerCase();\n    if (s === \"true\") return true;\n    if (s === \"false\") return false;\n  }\n  return null; // bilinmiyor\n};\n\n// normalize inputs\nconst currVal = toBool(getVal(cycleKey));\nconst flagVal = toBool(getVal(flagKey));\nconst steamVal = toBool(getVal(steamKey));\nconst nitrogenVal = toBool(getVal(nitrogenKey));\nconst pTmp = toNum(getVal(pressureKey));\nconst pressure = Number.isFinite(pTmp) ? pTmp : null;\n// state\nlet buffer = flow.get(bufferKey) || [];\nlet times = flow.get(timeKey) || {};\n\n// arıza ise örnek alma\nif (flagVal === true) return null;\n\n// cycle okunamadıysa (tip belirsiz) örneği atla\nif (currVal === null) return null;\n\n// started\nif (currVal === true) {\n  if (!times.startTime || buffer.length === 0) {\n    times.startTime = Date.now();\n    flow.set(timeKey, times);\n  }\n\n  const entry = {\n    ...msg.payload, // addressSpaceItems + value.results korunur\n    meta: {\n      steamIsRunning: (steamVal === true),\n      nitrogenIsRunning: (nitrogenVal === true),\n      pressure: pressure,   // format node'da normalize edilecek\n      capturedAt: Date.now()\n    }\n  };\n\n  buffer.push(entry);\n  flow.set(bufferKey, buffer);\n\n  node.status({ fill: \"green\", shape: \"dot\", text: `Buffering (${buffer.length} records)` });\n  return null;\n}\n\n// ended\nif (currVal === false && buffer.length > 0) {\n  times.endTime = Date.now();\n  if (times.endTime <= times.startTime) times.endTime = times.startTime + 1;\n\n  const startTimestamp = Math.floor(times.startTime / 1000);\n  const endTimestamp = Math.floor(times.endTime / 1000);\n\n  buffer.forEach(entry => { entry.timestamp = startTimestamp; });\n\n  msg.payload = { buffer, startTime: startTimestamp, endTime: endTimestamp };\n\n  flow.set(bufferKey, []);\n  flow.set(timeKey, {});\n\n  node.status({ fill: \"blue\", shape: \"dot\", text: \"Buffer sent\" });\n  return msg;\n}\n\nreturn null;\n",
        "outputs": 1,
        "timeout": 0,
