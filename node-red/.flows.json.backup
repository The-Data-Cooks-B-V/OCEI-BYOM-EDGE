    {
        "id": "aaab1023d4636b8f",
        "type": "function",
        "z": "6d4d2aa19f0a5553",
        "name": "Buffer Control 2VP8",
        "func": "const results = msg.payload?.value?.results || [];\nconst PREFIX = \"2VP8\";\nconst cycleKey    = `${PREFIX}-CycleIsRunning`;\nconst flagKey     = `${PREFIX}-Flag`;\nconst steamKey    = `${PREFIX}-ActualSteamIsRunning`;\nconst nitrogenKey = `${PREFIX}-ActualNitrogenRunning`;\nconst pressureKey = `${PREFIX}-ActualPressureInside`;\n\nconst bufferKey = `buffer_${PREFIX}`;\nconst timeKey   = `time_${PREFIX}`;\n\n// helpers\nconst scalar = v => (Array.isArray(v) ? v[v.length - 1] : v);     \nconst getVal = key => scalar(results.find(r => r.nodeId?.endsWith(key))?.value);\nconst toNum  = v => (typeof v === \"boolean\" ? (v ? 1 : 0) : Number(v));\nconst toBool = v => {\n  if (typeof v === \"boolean\") return v;\n  if (v === 1 || v === \"1\") return true;\n  if (v === 0 || v === \"0\") return false;\n  if (typeof v === \"string\") {\n    const s = v.trim().toLowerCase();\n    if (s === \"true\")  return true;\n    if (s === \"false\") return false;\n  }\n  return null; // bilinmiyor\n};\n\n// normalize inputs\nconst currVal     = toBool(getVal(cycleKey));\nconst flagVal     = toBool(getVal(flagKey));\nconst steamVal    = toBool(getVal(steamKey));\nconst nitrogenVal = toBool(getVal(nitrogenKey));\nconst pTmp        = toNum(getVal(pressureKey));\nconst pressure    = Number.isFinite(pTmp) ? pTmp : null;          \n// state\nlet buffer = flow.get(bufferKey) || [];\nlet times  = flow.get(timeKey) || {};\n\n// arıza ise örnek alma\nif (flagVal === true) return null;\n\n// cycle okunamadıysa (tip belirsiz) örneği atla\nif (currVal === null) return null;\n\n// started\nif (currVal === true) {\n  if (!times.startTime || buffer.length === 0) {\n    times.startTime = Date.now();\n    flow.set(timeKey, times);\n  }\n\n  const entry = {\n    ...msg.payload, // addressSpaceItems + value.results korunur\n    meta: {\n      steamIsRunning:    (steamVal === true),\n      nitrogenIsRunning: (nitrogenVal === true),\n      pressure:          pressure,   // format node'da normalize edilecek\n      capturedAt:        Date.now()\n    }\n  };\n\n  buffer.push(entry);\n  flow.set(bufferKey, buffer);\n\n  node.status({ fill: \"green\", shape: \"dot\", text: `Buffering (${buffer.length} records)` });\n  return null;\n}\n\n// ended\nif (currVal === false && buffer.length > 0) {\n  times.endTime = Date.now();\n  if (times.endTime <= times.startTime) times.endTime = times.startTime + 1;\n\n  const startTimestamp = Math.floor(times.startTime / 1000);\n  const endTimestamp   = Math.floor(times.endTime   / 1000);\n\n  buffer.forEach(entry => { entry.timestamp = startTimestamp; });\n\n  msg.payload = { buffer, startTime: startTimestamp, endTime: endTimestamp };\n\n  flow.set(bufferKey, []);\n  flow.set(timeKey, {});\n\n  node.status({ fill: \"blue\", shape: \"dot\", text: \"Buffer sent\" });\n  return msg;\n}\n\nreturn null;\n",
