    {
        "id": "c828983540cfac40",
        "type": "function",
        "z": "6d4d2aa19f0a5553",
        "name": "KPM Formats",
        "func": "const results = msg.payload?.value?.results;\nif (!Array.isArray(results)) return null;\n\nconst assetMap = (flow.get(\"assetMap\") || {}).assets || {};\nconst customerId = flow.get(\"customerId\") || \"0\";\nconst clientId = flow.get(\"clientId\") || \"0\";\nconst timestamp = Math.floor(Date.now() / 1000);\nconst ttl = timestamp + 94608000;\n\nconst prevKey = \"kpm_prev_vals\";\nlet prev = flow.get(prevKey) || {};\nconst out = [];\n\nfor (const key in assetMap) {\n    const asset_id = assetMap[key];\n    const match = results.find(r => r.nodeId?.toLowerCase().includes(key.toLowerCase()));\n    if (!match) continue;\n\n    const rawVal = match.value;\n    const val = typeof rawVal === \"boolean\" ? (rawVal ? 1 : 0) : Number(rawVal);\n    if (isNaN(val)) continue;\n\n    if (prev[asset_id] !== val) {\n        prev[asset_id] = val;\n\n        out.push({\n            asset_id,\n            val: val.toFixed(2),\n            customer_id: customerId,\n            client_id: clientId,\n            timestamp,\n            ttl\n        });\n    }\n}\n\nflow.set(prevKey, prev);\nreturn out.length > 0 ? [{ topic: \"KPM\", payload: out }] : null;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
