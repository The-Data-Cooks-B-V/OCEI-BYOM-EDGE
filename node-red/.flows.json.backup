    {
        "id": "37a2ef2dc4ee3507",
        "type": "function",
        "z": "6d4d2aa19f0a5553",
        "name": "Set Global AssetMap",
        "func": "flow.set(\"assetMap\", msg.payload);\nflow.set(\"customerId\", \"16\");\nglobal.set(\"customerId\", \"16\");\nflow.set(\"clientId\", \"0\");",
